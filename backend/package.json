{
  "name": "trip-angkut-api",
  "version": "1.0.0",
  "description": "Backend API for Aplikasi Trip Angkutan",
  "main": "src/index.js",
  "scripts": {
    "start": "node -e \"const fs=require('fs'),p=process.env.APK_DIR||'apks';try{fs.mkdirSync(p,{recursive:true})}catch(e){}const src='backend/apks';try{if(!fs.readdirSync(p).length&&fs.existsSync(src)){fs.readdirSync(src).forEach(f=>{try{fs.copyFileSync(src+'/'+f,p+'/'+f)}catch(e){}})}}catch(e){}\" && node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/check-client-trip-id.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "sql.js": "^1.14.2"
  }
}
